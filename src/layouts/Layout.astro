---
import { ClientRouter } from 'astro:transitions'

interface Props {
  title: string
}
const props = Astro.props
---
<!doctype html>
<html lang={Astro.currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="48x48" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} sizes="any" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{props.title}</title>
    <ClientRouter />
  </head>
  <body class="bg-background c-foreground transition-colors all-font-liga">
    <slot />
  </body>
</html>
